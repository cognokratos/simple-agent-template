# Ollama's OpenAI-compatible endpoint on the Docker host.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:8b

# Disable Qwen3 reasoning for short Guardrails Yes/No checks.
OLLAMA_GUARD_REASONING_EFFORT=none
OLLAMA_REASONING_EFFORT=none

# Demo Postgres credentials. Change these outside a local POC.
POSTGRES_USER=alerts
POSTGRES_PASSWORD=alerts
POSTGRES_DB=alerts

RUST_LOG=alerts_mcp_server=info,rmcp=info
