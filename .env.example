# ---------------------------------------------------------------------------
# Model endpoint
#
# Any OpenAI-compatible endpoint works. The defaults below target a local
# Ollama running qwen3:8b, and nothing in the system depends on Ollama
# specifically.
#
# qwen3:8b reliably handles single-tool and no-tool prompts (search, get,
# capability questions) in this support-ticket example. In repeated local
# testing it consistently failed to produce a final answer for the
# prioritization prompt ("Which ticket should we handle first, and why?"),
# instead fanning out to a get_ticket call per open ticket and never
# returning text -- a tool-orchestration limitation of this small model on a
# longer multi-tool trajectory, not a defect in the agent, MCP server, or
# guardrails, which all behaved correctly underneath it. qwen3.5:9b answered
# the identical prompt correctly and consistently against the same seed data
# and configuration; see docs/CONFIGURATION.md for how to switch.
# ---------------------------------------------------------------------------

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# Suppresses Qwen3 thinking, which otherwise breaks the short Yes/No guardrail
# classification. Leave these EMPTY for any provider that does not accept a
# reasoning_effort parameter: empty means the parameter is omitted from the
# request entirely, rather than sent as an empty value or as the string "null".
LLM_REASONING_EFFORT=none
LLM_GUARD_REASONING_EFFORT=none

# The guard model may differ from the agent model. It does NOT inherit LLM_MODEL:
# its fallback chain ends at the literal qwen3:8b, so any endpoint that does not
# serve that name must set this explicitly or the input rail fails on the first
# request.
# LLM_GUARD_MODEL=qwen3:8b

# Optional label for the upstream service behind LLM_BASE_URL (ollama, openai,
# ...), for provenance and traces. The agent always speaks the OpenAI-compatible
# protocol; this is descriptive only. The endpoint URL is never exported; only
# a fingerprint of it is.
# LLM_PROVIDER=ollama

# --- No Ollama? Replace the five lines above and use something like: ----------
# Use a current model name from your provider's own model list. The guard model
# may be a smaller/cheaper one, since it only performs a short classification.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<current chat model>
# LLM_GUARD_MODEL=<current chat model, or a smaller one>
# LLM_REASONING_EFFORT=
# LLM_GUARD_REASONING_EFFORT=
#
# Then `make dev`. No other change is required, and `make pull-models` becomes a
# no-op because it only applies to a local Ollama. qwen3:8b is the default this
# template ships and tests against; see the note above the model endpoint
# section for the one prompt where it is known to struggle, and
# docs/CONFIGURATION.md#model-endpoint for a tested alternative.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets

# ---------------------------------------------------------------------------
# Host ports and project identity
#
# Every published port binds to loopback by default, and the three a person
# actually opens are overridable, because these are the ports that collide:
# 6006 is Phoenix's and TensorBoard's default; 5000 (the optional MLflow) is
# held by macOS AirPlay Receiver; 3000 is the Next.js default and also
# open-webui's and Grafana's; 8082 is arbitrary but cheap to move. Container ports never change, so nothing inside the cluster is
# affected — but set UI_PUBLIC_URL and KEYCLOAK_PUBLIC_URL to match when you
# move those two, because the OIDC redirect and issuer are derived from them.
#
# COMPOSE_PROJECT_NAME overrides the project name pinned in docker-compose.yml,
# which is how a second clone (or a domain fork of this template) runs beside
# this one — with separate storage, not just separate containers: every
# persistent volume's default name is derived from the effective project name
# (COMPOSE_PROJECT_NAME, `docker compose -p`, or the tickets-agent default, in
# that order), so setting either one alone already isolates the volumes
# below without touching them individually.
#
# Only set these explicitly for a deployment that wants one specific, stable
# volume name regardless of project.
# ---------------------------------------------------------------------------

# PHOENIX_PORT=6006
# UI_PORT=3000
# KEYCLOAK_PORT=8082
# PUBLIC_BIND_ADDRESS=127.0.0.1
# COMPOSE_PROJECT_NAME=tickets-agent
# POSTGRES_DATA_VOLUME=tickets-agent-postgres-data
# PHOENIX_DATA_VOLUME=tickets-agent-phoenix-data
# KEYCLOAK_DATA_VOLUME=tickets-agent-keycloak-data
# KEYCLOAK_IMPORT_VOLUME=tickets-agent-keycloak-import

# ---------------------------------------------------------------------------
# Development secrets
#
# Every value below has a working default in docker-compose.yml, so the stack
# starts without setting any of them. They are listed here because they are the
# ones that must be replaced outside a local proof of concept — anyone opening
# this file should be able to see what the security-critical surface is.
#
# MCP_API_KEY              agent-to-MCP service credential
# AGENT_API_KEY            gateway-to-agent service credential, shared by the
#                          gateway, the evaluator and the agent
# KEYCLOAK_*               OIDC realm, client secret, and the demo login
# MCP_INSPECTOR_API_TOKEN  loopback-only Inspector UI token (dev profile)
# ---------------------------------------------------------------------------

# MCP_API_KEY=dev-mcp-api-key-change-me
# AGENT_API_KEY=dev-agent-api-key-change-me
# KEYCLOAK_GATEWAY_CLIENT_SECRET=dev-gateway-client-secret-change-me
# KEYCLOAK_AGENT_USERNAME=agent
# KEYCLOAK_AGENT_PASSWORD=agent
# MCP_INSPECTOR_API_TOKEN=dev-mcp-inspector-token-change-me

# ---------------------------------------------------------------------------
# Guardrails and telemetry
#
# GUARDRAILS_TRACE_CAPTURE_RAW_OUTPUT stays false: pre-mask output can contain
# exactly the PII or secret the output rails exist to stop. See docs/GUARDRAILS.md.
# ---------------------------------------------------------------------------

# GUARDRAILS_TRACE_CAPTURE_CONTENT=true
# GUARDRAILS_TRACE_CAPTURE_RAW_OUTPUT=false
# Ceiling on a streamed answer buffered for PII masking. Only relevant when
# the "mask sensitive data on output" flow is enabled; a response over this
# is refused, never released partially masked or unmasked.
# GUARDRAILS_PII_MAX_BUFFER_CHARS=200000
# Ceiling on the user text handed to the guard model. A longer message is
# refused, never truncated: a classifier shown a prefix decides about the
# prefix, so truncating would classify a long message on its benign opening.
# GUARDRAILS_INPUT_MAX_CHARS=32000
# Formerly NAT_TRACE_CAPTURE_CONTENT / NAT_TRACE_CONTENT_MAX_CHARS. Compose
# still maps the old names when these are unset, without a warning; rename
# them. See docs/CONFIGURATION.md#renamed-variables.
# AGENT_TRACE_CAPTURE_CONTENT=true
# AGENT_TRACE_CONTENT_MAX_CHARS=65536
# Export a pseudonymous per-user identifier on every span. Off by default:
# the traces already carry the question and the answer, and adding a stable
# per-user identifier turns them into a per-person record. Turn on where the
# trace backend is access-controlled. See docs/OBSERVABILITY.md.
# OTEL_TRACE_USER_ID=false

# ---------------------------------------------------------------------------
# Evaluation (core)
#
# The repository decides: evaluation/datasets/*.json, the deterministic
# scorers and the gates in evaluation/config.py. Every run writes its result to
# evaluation/results/<suite>-latest.json whatever is configured below.
# ---------------------------------------------------------------------------

# The identity the evaluation harness asserts to the agent. It calls the agent
# directly, so no browser login stands behind it, and the agent requires an
# asserted identity on every request.
# EVALUATION_PRINCIPAL=evaluation-harness
# Where a finished result is *also* published: phoenix (default), none, or
# phoenix,mlflow for the MLflow evaluator. Reporting never changes a result.
# EVALUATION_REPORTERS=phoenix

# ---------------------------------------------------------------------------
# Phoenix (default developer workbench)
#
# Runs in the default stack with no login, bound to loopback, its own usage
# telemetry disabled. Data persists in the phoenix-data volume until
# `make reset-phoenix`. Enable auth (an override file, not a variable here)
# before exposing it beyond loopback; see docs/CONFIGURATION.md#phoenix.
# ---------------------------------------------------------------------------

# PHOENIX_PROJECT_NAME=tickets-agent
# PHOENIX_PUBLIC_URL=http://localhost:6006
# Only for a Phoenix with auth enabled (set in docker-compose.override.yml,
# not here); the evaluator sends it as a bearer token.
# PHOENIX_API_KEY=

# ---------------------------------------------------------------------------
# MLflow (optional reference integration)
#
# Not started by `make dev`. `make dev-mlflow` adds it, exports traces to it
# through a second collector pipeline, and `make eval-mlflow` publishes the
# same evaluation result to both Phoenix and MLflow.
# ---------------------------------------------------------------------------

# MLFLOW_PORT=5000
# MLFLOW_DATA_VOLUME=tickets-agent-mlflow-data
# EVALUATION_MODEL_PREFIX=agent

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

RUST_LOG=tickets_mcp_server=info,rmcp=info
