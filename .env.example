# Must match a model already pulled by Ollama on the host. The POC uses the
# same model for application generation and Guardrails self-checks.
OLLAMA_MODEL=qwen3:8b

# The /v1 suffix is required by both AsyncOpenAI and langchain-openai.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama

# Identifier sent by the frontend to NeMo's OpenAI-compatible endpoint.
NEMO_MODEL=nemo-agent

# Ollama OpenAI-compatible reasoning control. "none" avoids hidden Qwen3
# thinking tokens and is recommended for this low-latency POC.
OLLAMA_REASONING_EFFORT=none
OLLAMA_GUARD_REASONING_EFFORT=none
