# ---------------------------------------------------------------------------
# Model endpoint
#
# Any OpenAI-compatible endpoint works. The defaults below target a local Ollama
# because the project is verified against qwen3:8b, but nothing in the system
# depends on Ollama.
# ---------------------------------------------------------------------------

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# Suppresses Qwen3 thinking, which otherwise breaks the short Yes/No guardrail
# classification. Leave these EMPTY for any provider that does not accept a
# reasoning_effort parameter: empty means the parameter is omitted from the
# request entirely, rather than sent as an empty value.
LLM_REASONING_EFFORT=none
LLM_GUARD_REASONING_EFFORT=none

# The guard model may differ from the agent model. It does NOT inherit LLM_MODEL:
# its default is the literal qwen3:8b, so any endpoint that does not serve that
# name must set this explicitly or the input rail fails on the first request.
# LLM_GUARD_MODEL=qwen3:8b

# --- No Ollama? Replace the five lines above and use something like: ----------
# Use a current model name from your provider's own model list. The guard model
# may be a smaller/cheaper one, since it only performs a short classification.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<current chat model>
# LLM_GUARD_MODEL=<current chat model, or a smaller one>
# LLM_REASONING_EFFORT=
# LLM_GUARD_REASONING_EFFORT=
#
# Then `make dev`. No other change is required, and `make pull-models` becomes a
# no-op. Only qwen3:8b is verified end to end; see the README for the others.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

POSTGRES_USER=etf_research
POSTGRES_PASSWORD=etf_research
POSTGRES_DB=etf_research

# ---------------------------------------------------------------------------
# Host ports
#
# Every published port binds to loopback by default. Only MLflow's is variable,
# because 5000 is the one that reliably collides — macOS AirPlay Receiver holds
# it, and so does any other MLflow on the machine. The container port stays 5000
# either way, so nothing inside the cluster changes.
# ---------------------------------------------------------------------------

# MLFLOW_PORT=5000
# PUBLIC_BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# Development secrets
#
# Every value below has a working default in docker-compose.yml, so the stack
# starts without setting any of them. They are listed here because they are the
# ones that must be replaced outside a local proof of concept — anyone opening
# this file should be able to see what the security-critical surface is.
#
# MCP_API_KEY              NAT-to-MCP service credential
# HITL_APPROVAL_SECRET     HMAC key the approval signer and the MCP verifier
#                          share. Minimum 24 characters, enforced at startup.
# AGENT_API_KEY            gateway-to-NAT service credential (NAT reads it as
#                          NAT_GATEWAY_API_KEY)
# KEYCLOAK_*               OIDC realm, client secret, and the demo login
# MCP_INSPECTOR_API_TOKEN  loopback-only Inspector UI token
# ---------------------------------------------------------------------------

# MCP_API_KEY=dev-mcp-api-key-change-me
# AGENT_API_KEY=dev-agent-api-key-change-me
# HITL_APPROVAL_SECRET=dev-hitl-approval-secret-change-me-32chars
# KEYCLOAK_GATEWAY_CLIENT_SECRET=dev-gateway-client-secret-change-me
# KEYCLOAK_RESEARCHER_USERNAME=researcher
# KEYCLOAK_RESEARCHER_PASSWORD=researcher
# MCP_INSPECTOR_API_TOKEN=dev-mcp-inspector-token-change-me

# ---------------------------------------------------------------------------
# Deterministic policy inputs
#
# These are read-only mounts of the files in data/. Point them somewhere else to
# evaluate the same ETF universe against a different investor profile or a
# different rules specification; nothing about the policy is compiled in.
# ---------------------------------------------------------------------------

# RULES_SPEC_PATH=/app/data/rules_spec.json
# INVESTOR_PROFILE_PATH=/app/data/investor_profile.json
# ETFS_DATA_PATH=/app/data/etfs.json

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

RUST_LOG=etf_mcp_server=info,rmcp=info
